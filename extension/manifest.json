{
  "manifest_version": 3,
  "name": "Hub de Pierre — YouTube → TV Time",
  "short_name": "YT → TV Time",
  "version": "1.0.0",
  "description": "Marque dans le module TV Time du Hub de Pierre les vidéos YouTube regardées (25 % par défaut) ou résumées par l'IA, via Dropbox.",
  "key": "",
  "permissions": ["storage", "identity", "alarms"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://api.dropboxapi.com/*",
    "https://content.dropboxapi.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["https://www.youtube.com/*"], "js": ["page.js"], "world": "MAIN", "run_at": "document_idle" },
    { "matches": ["https://www.youtube.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle" }
  ],
  "action": { "default_popup": "popup.html", "default_title": "YouTube → TV Time", "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" } },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
